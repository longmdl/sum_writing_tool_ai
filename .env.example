# Copy this file to .env.local and fill in your key.
#   cp .env.example .env.local
#
# On Vercel, add these under Project -> Settings -> Environment Variables
# instead. Never commit a real key: .env* is gitignored.

# Required. Create one at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional. Any OpenAI model that supports JSON response format.
# Defaults to gpt-4o if unset. Bump this when a newer model is on your account.
OPENAI_MODEL=gpt-4o

# Required for the 30-day Generated Work archive.
# Keep the secret key server-only; never prefix it with NEXT_PUBLIC_.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional. Separates irreversible IP hashing from the Supabase secret.
# Use a long random value and keep it server-only. Changing it resets IP quotas.
RATE_LIMIT_HASH_SECRET=replace-with-a-long-random-secret

# Optional comma-separated override for the combined public Reddit RSS feed.
# No Reddit API credentials are used. Keep this list compact to avoid a long URL.
# REDDIT_RSS_COMMUNITIES=formuladank,CarMemes,carscirclejerk,Shitty_Car_Mods

# Optional descriptive user agent for Reddit RSS and hosted media requests.
# REDDIT_RSS_USER_AGENT=SUM Editorial/1.0 (+https://newsfeed.sumracing.vn)
